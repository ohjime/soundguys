# Production environment for docker-compose. Copy to `env/.env` on the droplet and
# fill in real values. The real `env/.env` is git-ignored — never commit it.

# --- Django ---
SECRET_KEY=GENERATE_ME            # python -c "import secrets;print(secrets.token_urlsafe(64))"
DEBUG=False
# Domain(s) to serve + accept.
# SITE_ADDRESS feeds Caddy (TLS + proxy); Caddy needs each hostname explicitly
#   to fetch its cert, so list every served subdomain here. admin.cosound.ca is a
#   normal entry — it's served at the subdomain root by Django host routing
#   (config/middleware.py + config/urls_admin.py), no special Caddy block needed.
# PROD_HOSTS feeds Django ALLOWED_HOSTS/CSRF and supports a leading-dot wildcard:
#   ".cosound.ca" matches the apex and EVERY subdomain (present + future), so this
#   never needs editing when you add a subdomain. No spaces in PROD_HOSTS.
#   STAGING example: SITE_ADDRESS=staging.cosound.ca   PROD_HOSTS=.cosound.ca
SITE_ADDRESS=cosound.ca, www.cosound.ca, admin.cosound.ca, api.cosound.ca, play.cosound.ca, studio.cosound.ca
PROD_HOSTS=.cosound.ca
WEB_CONCURRENCY=1                 # 1 gunicorn worker for the 1 GB droplet
VOTE_THROTTLE_SECONDS=60
SERVER_REFRESH_INTERVAL=30

# --- Postgres (db reads POSTGRES_*, Django reads DATABASE_URL; keep the password in sync) ---
POSTGRES_USER=cosound
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=cosound
DATABASE_URL=postgres://cosound:CHANGE_ME_STRONG@db:5432/cosound   # host "db" = the compose service

# --- Redis (internal Compose service; shared by every Django process) ---
# Override with a managed redis:// or rediss:// URL when needed.
REDIS_URL=redis://redis:6379/0

# --- AWS (S3 media + SES email) ---
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_STORAGE_BUCKET_NAME=cosounds-frishkopf
AWS_S3_REGION_NAME=us-east-2

# --- First admin (optional bootstrap) ---
FIRST_ADMIN_EMAIL=admin@cosound.ca
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_STRONG
